ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password
COOKIE_SECURE=false
PORT=8000
DATA_DIR=./data

# Database: empty DATABASE_URL keeps the zero-config SQLite file at
# DATABASE_PATH. For PostgreSQL, set a postgresql:// or postgres:// URL.
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_BUSY_TIMEOUT_MS=15000
SQLITE_CACHE_SIZE_KIB=16384
ANALYSIS_CACHE_TTL_SECONDS=10

# Only needed for the optional Compose profile:
#   docker compose --profile postgres up -d postgres
# POSTGRES_DB=kontur
# POSTGRES_USER=kontur
# POSTGRES_PASSWORD=replace-with-a-unique-database-password
# DATABASE_URL=postgresql://kontur:replace-with-a-unique-database-password@postgres:5432/kontur

# Optional OpenID Connect login (password login stays as fallback).
# Set issuer + client id to enable the SSO button on the login page.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
OIDC_PROVIDER_NAME=SSO
OIDC_ALLOWED_USERS=
