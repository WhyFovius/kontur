# Copy to .env.production on the server and chmod 600 it.
# Never commit the real file.

# Public domain served by the optional Caddy profile. Its DNS A/AAAA
# record must point at the Aéza server before HTTPS can be issued.
SITE_DOMAIN=kontur.example.com

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password

# true is required for the public HTTPS deployment. Set false only for a
# temporary SSH-tunnel smoke test without a domain.
COOKIE_SECURE=true

# The application itself is published on 127.0.0.1 only; Caddy/nginx is
# the public edge on 80/443.
PORT=8000
FORWARDED_ALLOW_IPS=*

# Empty DATABASE_URL keeps SQLite in the named Docker volume. This is
# the recommended setup for one Aéza VPS and one application process.
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_BUSY_TIMEOUT_MS=15000
SQLITE_CACHE_SIZE_KIB=16384
ANALYSIS_CACHE_TTL_SECONDS=10

# Public sign-ups are demo previews only: every registered visitor gets
# an isolated pre-seeded SQLite workspace under /app/data/workspaces and
# cannot read or modify the administrator workspace. Raise/lower the cap
# for the size of the VPS, or disable new sign-ups without affecting the
# administrator/OIDC login.
PUBLIC_REGISTRATION_ENABLED=true
MAX_REGISTERED_USERS=200
DEMO_WORKSPACE_DIR=/app/data/workspaces

# Only for docker-compose.prod.yml --profile postgres. If enabled, also
# set DATABASE_URL=postgresql://kontur:<password>@postgres:5432/kontur
# POSTGRES_DB=kontur
# POSTGRES_USER=kontur
# POSTGRES_PASSWORD=replace-with-a-long-unique-database-password

# Optional OpenID Connect login. Password login stays as fallback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
OIDC_PROVIDER_NAME=SSO
OIDC_ALLOWED_USERS=
